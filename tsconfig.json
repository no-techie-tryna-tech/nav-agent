{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["node"]
  },
  "include": [
    "memo-agent/engine/**/*.js",
    "memo-agent/js/calc.js",
    "scripts/*.mjs"
  ]
}
